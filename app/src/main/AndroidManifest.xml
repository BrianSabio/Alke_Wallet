<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_alkewallet"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_alkewallet"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlkeWallet">
        <activity
            android:name=".splash.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".auth.AuthActivity" />
        <activity android:name=".home.HomePageActivity" />
        <activity android:name=".profile.ProfileActivity" />
        <activity android:name=".transactions.SendMoneyActivity" />
        <activity android:name=".transactions.RequestMoneyActivity" />
    </application>

</manifest>